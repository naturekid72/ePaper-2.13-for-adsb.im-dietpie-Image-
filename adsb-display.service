[Unit]
Description=ADS-B e-Paper Display Service (Waveshare 2.13 V4)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adsb-epaper
ExecStart=/usr/bin/python3 /opt/adsb-epaper/adsb_display.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
